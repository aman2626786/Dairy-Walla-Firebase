# Google Cloud SQL Connection Example
# Copy करके अपने .env में पेस्ट करें और values fill करें

# PostgreSQL Database URL (Google Cloud SQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_CLOUD_SQL_IP:5432/dairy_walla_db"

# Supabase से Google Cloud migrate करते समय
# पहले यह set करके backup लें:
# SUPABASE_DB_URL="postgresql://postgres:SUPABASE_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Environment
NODE_ENV="production"

# Optional: Logging
LOG_LEVEL="info"

# अगर आप अभी भी Supabase का कुछ उपयोग कर रहे हैं (जैसे Auth):
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_ANON_KEY="YOUR_ANON_KEY"
