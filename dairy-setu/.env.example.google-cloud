# Google Cloud SQL Connection Example
# Copy करके अपने .env में पेस्ट करें और values fill करें

# PostgreSQL Database URL (Google Cloud SQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_CLOUD_SQL_IP:5432/dairy_walla_db"

# Supabase से Google Cloud migrate करते समय
# पहले यह set करके backup लें:
# SUPABASE_DB_URL="postgresql://postgres:SUPABASE_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Environment
NODE_ENV="production"

# Optional: Logging
LOG_LEVEL="info"

# अगर आप अभी भी Supabase का कुछ उपयोग कर रहे हैं (जैसे Auth):
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Firebase Admin SDK (required for backend token verification)
# Option 1: paste full service account JSON in one line
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
#
# Option 2: base64 encode the full service account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64="base64-encoded-json"
#
# Option 3: set individual fields
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
